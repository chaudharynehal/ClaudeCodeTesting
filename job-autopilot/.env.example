# ---------------------------------------------------------------------------
# JobPilot configuration. Copy this file to ".env" and fill in the values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Local SQLite database (no external service needed). Leave as-is.
DATABASE_URL="file:./dev.db"

# Required for AI resume/cover-letter tailoring and fit summaries.
# Get a key at https://console.anthropic.com/ . Without it, you can still
# browse/match/track jobs — only the "Tailor" feature is disabled.
ANTHROPIC_API_KEY=""

# Optional: override the model used for tailoring (default: claude-opus-4-8).
# ANTHROPIC_MODEL="claude-opus-4-8"

# ---------------------------------------------------------------------------
# Optional: email response tracking (IMAP). If set, the dashboard can scan
# your inbox and auto-update application statuses (responded / interview /
# offer / rejected) by matching messages to the companies you applied to.
#
# Gmail: create an App Password (https://myaccount.google.com/apppasswords)
# and use it below — do NOT use your normal password.
# ---------------------------------------------------------------------------
# IMAP_HOST="imap.gmail.com"
# IMAP_PORT="993"
# IMAP_USER="you@gmail.com"
# IMAP_PASSWORD="your-app-password"
